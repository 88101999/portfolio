<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1 class="text-center mb-4">おすすめのコーディネート</h1>
      <% @coordinates.each do |coordinate| %>
        <div class="card mb-4 shadow-sm">
          <%# 画像が添付されている場合のみ表示 %>
          <% if coordinate.image.attached? %>
            <%= image_tag coordinate.image, alt: coordinate.name, class: "card-img-top coordinate-image" %>
          <% end %>
          
          <div class="card-body">
            <h5 class="card-title"><%= coordinate.name %></h5>
            <p class="card-text"><%= coordinate.description %></p>

            <div class="ai-explanation">
              <h4>【このコーディネートがおすすめな理由】</h4>
              <p><%= simple_format(@answer_log.ai_explanation) %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>