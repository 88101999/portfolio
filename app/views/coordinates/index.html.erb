<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1 class="text-center mb-4">おすすめのコーディネート</h1>
      <% @coordinates.each do |coordinate| %>
        <div class="card mb-4 shadow-sm">
          <%# 画像が添付されている場合のみ表示 %>
          <% if coordinate.image.attached? %>
            <%= image_tag coordinate.image, alt: coordinate.name, class: "card-img-top coordinate-image" %>
          <% end %>
          
          <div class="card-body">
            <h5 class="card-title"><%= coordinate.name %></h5>
            <p class="card-text"><%= coordinate.description %></p>

            <div class="ai-explanation">
              <h4>【AIがこのコーディネートを解説します!】</h4>
              <% if @ai_explanation_error.present? %>
                <!-- エラーメッセージを表示 -->
                <div class="alert alert-warning" role="alert">
                  <%= @ai_explanation_error %>
                </div>
              <% elsif @answer_log.ai_explanation.present? %>
                <!-- AI解説を表示 -->
                <p><%= simple_format(@answer_log.ai_explanation) %></p>
              <% else %>
                <!-- AI解説がまだ生成されていない場合のメッセージ -->
                <p>AIによる解説を生成中です。しばらくお待ちください...</p>
              <% end %>
            </div>
            
            <div class="mt-3">
              <% if bookmarked?(coordinate) %>
                <%= button_to 'お気に入りから削除',
                              bookmark_path(find_bookmark(coordinate)),
                              method: :delete,
                              class: 'btn btn-warning' %>
              <% else %>
                <%= button_to 'お気に入りに追加',
                              bookmarks_path(coordinate_id: coordinate.id),
                              method: :post,
                              class: 'btn btn-primary' %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>