  <% content_for :title, 'お気に入りコーディネート一覧' %>
  <div class="container pt-3">
    <div class="row">
      <div class="col-12">
        <p>お気に入りコーディネート一覧</p>

        <% if @bookmarks.any? %>
          <div class="row">
            <% @bookmarks.each do |bookmark| %>
              <% coordinate = bookmark.coordinate %>
              <div class="col-md-6 col-lg-4 mb-4" id="bookmark-card-<%= coordinate.id %>">
                <div class="card h-100" style="cursor: pointer;"
                     data-bs-toggle="modal"
                     data-bs-target="#coordinateModal<%= coordinate.id %>">
                  <% if coordinate.image.attached? %>
                    <%= image_tag coordinate.image, alt: coordinate.name, class: "card-img-top" %>
                  <% end %>
                  <div class="card-body">
                    <h5 class="card-title"><%= bookmark.coordinate.name %></h5>
                    <p class="card-text"><%= truncate(coordinate.description, length: 100) %></p>
                  </div>
                </div>
              </div>

              <%= render 'coordinates/modal', coordinate: coordinate, bookmark: bookmark %>
            <% end %>
          </div>
        <% else %>
          <p>お気に入りのコーディネートがありません</p>
        <% end %>
      </div>
    </div>
  </div>