<% if request.referer&.include?('bookmarks') %>
  <%= turbo_stream.remove "bookmark-card-#{@coordinate.id}" %>
<% else %>
  <%= turbo_stream.replace "bookmark-button-#{@coordinate.id}" do %>
    <%= render 'bookmarks/bookmark_button', coordinate: @coordinate %>
  <% end %>
<% end %>

<%= turbo_stream.prepend "flash_messages" do %>
  <div class="alert alert-success">
    お気に入りから削除しました
  </div>
<% end %>