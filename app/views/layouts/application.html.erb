<!DOCTYPE html>
<html>
  <head>
    <title>Coordia</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- OGPタグ -->
    <meta property="og:title" content="Coordia">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="https://portfolio-kvvz.onrender.com/images/Coordia_OGP.png">
    <meta property="og:site_name" content="Coordia">
    <meta property="og:description" content="質問に答えるだけで、あなたに合うコーディネートを提案します">

    <!-- X(Twitter)カード -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Coordia">
    <meta name="twitter:image" content="https://portfolio-kvvz.onrender.com/images/Coordia_OGP.png">
    <meta name="twitter:description" content="質問に答えるだけで、あなたに合うコーディネートを提案します">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100 background-wrapper <%= yield(:body_class) %>">
    <% if logged_in? %>
      <%= render 'shared/header' %>
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>
    <div id="flash_messages">
      <%= render 'shared/flash_message' %>
    </div>

    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>
  </body>
</html>
