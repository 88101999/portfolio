<div class="container">
  <div class="login-wrapper">
    <!-- 左側: ログインフォーム -->
    <div class="login-form-section">
      <!-- タイトル -->
      <h1><%= t('.title') %></h1>
      
      <%= form_with url: login_path do |f| %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class="form-check mb-3">
          <%= f.check_box :remember, { checked: true, class: 'form-check-input', id: 'remember'}, 'true', 'false' %>
          <%= f.label :remember, class: 'form-check-label' %>
        </div>
        <!-- ボタンテキスト -->
        <%= f.submit t('.login'), class: "btn btn-primary w-100" %>
      <% end %>

      <div class="mt-3 text-center">
        <p class="text-muted"><%= t('.or') %></p>
        <%= button_to t('.google_login'),
              auth_at_provider_path(provider: :google),
              method: :post,
              class: 'btn btn-outline-danger w-100',
              data: { turbo: false } %>
      </div>

      <div class="mt-3 text-center">
        <%= link_to t('.password_forget'), new_password_reset_path, class: 'text-muted small' %>
      </div>
    </div>

    <div class="signup-guide-section">
      <h2><%= t('.first_time_title') %></h2>
      <p class="guide-text">
        <%= t('.first_time_text') %>
      </p>
      <%= link_to t('.to_register'), new_user_path, class: 'btn btn-outline-primary w-100' %>
    </div>
  </div>
</div>