<div class="container">
  <div class="login-wrapper">
    <!-- 左側: ログインフォーム -->
    <div class="login-form-section">
      <h1>ログイン</h1>
      <%= form_with url: login_path do |f| %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class="form-check mb-3">
          <%= f.check_box :remember, { checked: true,  class: 'form-check-input', id: 'remember'}, 'true', 'false' %>
          <%= f.label :remember, '次回から自動的にログインする', class: 'form-check-label' %>
        </div>
        <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
      <% end %>

      <div class="mt-3 text-center">
        <p class="text-muted">または</p>
        <%= button_to 'Googleでログイン',
              auth_at_provider_path(provider: :google),
              method: :post,
              class: 'btn btn-outline-danger w-100',
              data: { turbo: false } %>
      </div>

      <div class="mt-3 text-center">
        <%= link_to 'パスワードをお忘れの方はこちら', new_password_reset_path, class: 'text-muted small' %>
      </div>
    </div>

    <div class="signup-guide-section">
      <h2>初めてご利用の方</h2>
      <p class="guide-text">
        ご利用にはユーザー登録が必要です。
      </p>
      <%= link_to '新規登録', new_user_path, class: 'btn btn-outline-primary w-100' %>
    </div>
  </div>
</div>